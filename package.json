{
  "name": "pi-shell",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal shell-prompt interface for the Pi agent harness. No TUI, just a > prompt with clean text output and persistent session history.",
  "type": "module",
  "bin": {
    "pi-shell": "./src/pi-shell.ts"
  },
  "scripts": {
    "start": "tsx src/pi-shell.ts",
    "dev": "tsx watch src/pi-shell.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
